10 MEMORY &8FFF:MODE 2
20 PRINT "QLIB vs LOCOMOTIVE BASIC - 10000 ITERATIONS"
30 PRINT "CLOCK: TIME = TICKS / 300 SECONDES"
40 PRINT "TEST STANDARD BASIC"
50 S%=0:T0=TIME
60 FOR I%=1 TO 10000
70 M%=13*17
80 NEXT I%
90 FOR I%=1 TO 10000
100 S%=S%+1
110 NEXT I%
120 TB=TIME-T0
130 PRINT "BASIC  TICKS:";TB
140 PRINT "BASIC  MUL:";M%;" ADD:";S%
150 PRINT "TEST QLIB ROM"
160 T0=TIME
170 |MBENCH
180 TR=TIME-T0
185 |MRESULT
190 MROM=PEEK(&9010)+256*PEEK(&9011)
200 SROM=PEEK(&9012)+256*PEEK(&9013)
210 PRINT "QLIB   TICKS:";TR
220 PRINT "QLIB   MUL:";MROM;" ADD:";SROM
230 IF MROM<>221 OR SROM<>10000 THEN PRINT "RESULTAT: FAIL":END
240 PRINT "RESULTAT: PASS"
250 IF TR>0 THEN PRINT "RAPPORT BASIC/QLIB:";INT(TB/TR*100)/100
260 PRINT "ATTENTION: BOUCLES BASIC NON OPTIMISEES"
